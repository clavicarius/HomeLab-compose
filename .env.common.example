## common environment variables for all containers

########################################
# Host User ID
########################################
# Benutzer
PUID=1000
PGID=1000
TZ=Europe/Berlin

########################################
# Host paths
########################################
# Shared root for all service data/configuration directories.
# The default keeps data in this repository; set an absolute host path to relocate it.
DOCKER_ROOT=..
DOCKER_SOCKET_PATH=/var/run/docker.sock
HOST_LOCALTIME_PATH=/etc/localtime
HOST_TIMEZONE_PATH=/etc/TZ

########################################
# Network
# 192.168.178.225 - 192.168.178.254
########################################
SUBNET=192.168.178.224/27
GATEWAY=192.168.178.1
NETWORK_NAME=homelab_macvlan
# Synology: Parent-Interface per Live-Test festlegen (z. B. `ip -o link show`)
# Häufig ist `ovs_eth0` oder `bond0` korrekt, nicht zwingend `eth0`
NETWORK_ADAPTER=eth0

########################################
# Domains
########################################
HOMELAB_DOMAIN=home.arpa
HOMELAB_EMAIL=admin@home.arpa

#######################################
# Traefik
#######################################
TRAEFIK_ENABLED=true
TRAEFIK_TLS_ENABLED=true
# ACME resolver configured by the Traefik stack
CERT_RESOLVER=stepca

## ** common environment ends here **
