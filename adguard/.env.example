########################################
# adguard environment
########################################

########################################
# Network
########################################
ADGUARD_HOST=adguard
# Traefik router rule; add more hostnames with `|| Host(...)`
ADGUARD_HOST_RULE="Host(`${ADGUARD_HOST}.${HOMELAB_DOMAIN}`)"
ADGUARD_IP=192.168.178.252

########################################
#      ${DOCKER_DATA_ROOT}/${ADGUARD_HOST}
########################################
ADGUARD_CONF_PATH=${DOCKER_DATA_ROOT}/${ADGUARD_HOST}/conf
ADGUARD_WORK_PATH=${DOCKER_DATA_ROOT}/${ADGUARD_HOST}/work

# Optionale service-spezifische Overrides fuer AdGuard.
# Zentrale Werte (Benutzer, Netzwerk, Domain, Traefik) kommen aus ../.env.common
