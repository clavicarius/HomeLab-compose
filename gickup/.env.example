########################################
# gickup environment
########################################

########################################
# Network
########################################
GICKUP_HOST=gickup
GICKUP_IP=192.168.178.246
GITEA_URL=http://gitea:3000

########################################
#      ${DOCKER_DATA_ROOT}/${GICKUP_HOST}
########################################
GICKUP_BACKUPS_PATH=${DOCKER_DATA_ROOT}/${GICKUP_HOST}/backups

# Optionale service-spezifische Overrides fuer gickup.
# Zentrale Werte (Benutzer, Netzwerk, Domain, Traefik) kommen aus ../.env.common
GITEA_TOKEN=replace-with-a-read-only-gitea-token
GICKUP_CRON=0 23 * * *
