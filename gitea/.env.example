########################################
# gitea environment
########################################

########################################
# Network
########################################
GITEA_HOST=gitea
# Traefik router rule; add more hostnames with `|| Host(...)`
GITEA_HOST_RULE="Host(`${GITEA_HOST}.${HOMELAB_DOMAIN}`) || Host(`git.${HOMELAB_DOMAIN}`)"
GITEA_IP=192.168.178.248

########################################
#      ${DOCKER_DATA_ROOT}/${GITEA_HOST}
########################################
GITEA_DATA_PATH=${DOCKER_DATA_ROOT}/${GITEA_HOST}/data


# Optionale service-spezifische Overrides fuer Gitea.
# Zentrale Werte (Benutzer, Netzwerk, Domain, Traefik, Host/IP) kommen aus ../.env.common
GITEA_PORT=3000
GITEA_SSH_PORT=2222
