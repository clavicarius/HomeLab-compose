########################################
# paperless environment
########################################

########################################
# Network
########################################
PAPERLESS_HOST=paperless
PAPERLESS_IP=192.168.178.249

########################################
#      ${DOCKER_DATA_ROOT}/${PAPERLESS_HOST}
########################################
PAPERLESS_DATA_PATH=${DOCKER_DATA_ROOT}/${PAPERLESS_HOST}/data
PAPERLESS_MEDIA_PATH=${DOCKER_DATA_ROOT}/${PAPERLESS_HOST}/media
PAPERLESS_EXPORT_PATH=${DOCKER_DATA_ROOT}/${PAPERLESS_HOST}/export
PAPERLESS_CONSUME_PATH=${DOCKER_DATA_ROOT}/${PAPERLESS_HOST}/consume
PAPERLESS_SCRIPT_PATH=${DOCKER_DATA_ROOT}/${PAPERLESS_HOST}/scripts
PAPERLESS_DB_DATA_PATH=${DOCKER_DATA_ROOT}/${PAPERLESS_HOST}/dbdata
PAPERLESS_REDIS_DATA_PATH=${DOCKER_DATA_ROOT}/${PAPERLESS_HOST}/redisdata


# Optionale service-spezifische Overrides fuer paperless.
# Zentrale Werte (Benutzer, Netzwerk, Domain, Traefik) kommen aus ../.env.common
PAPERLESS_DB_PASSWORD=change-this-password
PAPERLESS_SECRET_KEY=change-this-to-a-random-secret
