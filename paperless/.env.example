########################################
# Host paths
#      ${DOCKER_ROOT}/paperless
########################################
PAPERLESS_DATA_PATH=./data
PAPERLESS_MEDIA_PATH=./media
PAPERLESS_EXPORT_PATH=./export
PAPERLESS_CONSUME_PATH=./consume
PAPERLESS_SCRIPT_PATH=./scripts
PAPERLESS_DB_DATA_PATH=./dbdata
PAPERLESS_REDIS_DATA_PATH=./redisdata


########################################
# Network
########################################
