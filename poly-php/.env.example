########################################
# Host paths
#      ${DOCKER_ROOT}/poly-php 
########################################
POLYPHP_HTML_PATH=./html
POLYPHP_PHP_CONFIG_PATH=./php-config/php.ini
POLYPHP_XDEBUG_CONFIG_PATH=./php-config/xdebug-php56.ini
POLYPHP_PHP56_LOGS_PATH=./logs/php56
POLYPHP_PHP74_LOGS_PATH=./logs/php74
POLYPHP_PHP85_LOGS_PATH=./logs/php85
POLYPHP_MYSQL_DATA_PATH=./mysql_data
POLYPHP_DB_INIT_PATH=./db-init


########################################
# Network
########################################
POLYPHPADM_IP=192.168.178.234
POLYPHP56_IP=192.168.178.235
POLYPHP74_IP=192.168.178.237
POLYPHP85_IP=192.168.178.238

########################################
# Database
########################################
