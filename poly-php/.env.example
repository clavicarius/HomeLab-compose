########################################
# poly-php environment
########################################
POLY_PHP_HOST=poly-php

########################################
# Network
########################################
POLYPHPADM_IP=192.168.178.234
POLYPHP56_IP=192.168.178.235
POLYPHP74_IP=192.168.178.237
POLYPHP85_IP=192.168.178.238

########################################
# Database
########################################
## MariaDB runs on the internal stack network and is not exposed via macvlan.

MYSQL_ROOT_PASSWORD=root_Hard2Crack!Secret
MYSQL_DATABASE=lamp_db
MYSQL_USER=lamp_dbuser
MYSQL_PASSWORD=lamp_dbSecretPassword

########################################
# PHP ports
########################################
PHP56_PORT=8056
PHP74_PORT=8074
PHP85_PORT=8085

PHPMYADMIN_PORT=8080


########################################
#      ${DOCKER_DATA_ROOT}/${POLY_PHP_HOST}
########################################
POLYPHP_HTML_PATH=${DOCKER_DATA_ROOT}/${POLY_PHP_HOST}/html
POLYPHP_PHP_CONFIG_PATH=${DOCKER_DATA_ROOT}/${POLY_PHP_HOST}/php-config/php.ini
POLYPHP_XDEBUG_CONFIG_PATH=${DOCKER_DATA_ROOT}/${POLY_PHP_HOST}/php-config/xdebug-php56.ini
POLYPHP_PHP56_LOGS_PATH=${DOCKER_DATA_ROOT}/${POLY_PHP_HOST}/logs/php56
POLYPHP_PHP74_LOGS_PATH=${DOCKER_DATA_ROOT}/${POLY_PHP_HOST}/logs/php74
POLYPHP_PHP85_LOGS_PATH=${DOCKER_DATA_ROOT}/${POLY_PHP_HOST}/logs/php85
POLYPHP_MYSQL_DATA_PATH=${DOCKER_DATA_ROOT}/${POLY_PHP_HOST}/mysql_data
POLYPHP_DB_INIT_PATH=${DOCKER_DATA_ROOT}/${POLY_PHP_HOST}/db-init
