########################################
# traefik environment 
########################################

########################################
# Network
########################################
TRAEFIK_HOST=traefik
TRAEFIK_IP=192.168.178.225

########################################
# traefik environment 
#      ${DOCKER_DATA_ROOT}/${TRAEFIK_HOST}
########################################
TRAEFIK_CERTS_PATH=${DOCKER_DATA_ROOT}/${TRAEFIK_HOST}/certs
TRAEFIK_CONFIG_PATH=${DOCKER_DATA_ROOT}/${TRAEFIK_HOST}/config
TRAEFIK_LETSENCRYPT_PATH=${DOCKER_DATA_ROOT}/${TRAEFIK_HOST}/letsencrypt


########################################
# Traefik
########################################
TRAEFIK_ENTRYPOINT=websecure
# Hetzner DNS API token with permission to edit DNS records for HOMELAB_DOMAIN
HETZNER_API_TOKEN=
# Optional: traefik/config/tls.yml kann ein mkcert-Wildcardzertifikat aus traefik/certs/ laden.

########################################
# Authentication
########################################
TRAEFIK_BASIC_AUTH="user:password"

########################################
# step-ca
########################################
STEP_CA_PASSWORD=TopSecretPassw0rd
STEP_CA_ACME_EMAIL=admin@${HOMELAB_DOMAIN}
