########################################
# Host paths
#      ${DOCKER_ROOT}/traefik
########################################
TRAEFIK_CERTS_PATH=./certs
TRAEFIK_CONFIG_PATH=./config
TRAEFIK_ACME_PATH=./letsencrypt

########################################
# Network
########################################
TRAEFIK_HOST=traefik
TRAEFIK_IP=192.168.178.225

########################################
# Traefik
########################################
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=letsencrypt
# Optional: traefik/config/tls.yml kann ein mkcert-Wildcardzertifikat aus traefik/certs/ laden.
HETZNER_API_TOKEN=

########################################
# Authentication
########################################
TRAEFIK_BASIC_AUTH="user:password"

########################################
# step-ca
########################################
STEP_CA_PASSWORD=TopSecretPassw0rd
STEP_CA_ACME_EMAIL=admin@home.example.com
