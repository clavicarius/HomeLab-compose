
http:
  routers:

    dashboard-http:
      rule: Host(`${TRAEFIK_HOST}.${HOMELAB_DOMAIN}`)
      entryPoints:
        - ${TRAEFIK_ENDPOINT}

      middlewares:
        - redirect-to-https

      service: api@internal

    dashboard-https:
      rule: Host(`${TRAEFIK_HOST}.${HOMELAB_DOMAIN}`)
      entryPoints:
        - ${TRAEFIK_ENDPOINT}

      tls:
        certResolver: ${CERT_RESOLVER}

      middlewares:
        - dashboard-auth

      service: api@internal


  middlewares:

    redirect-to-https:

      redirectScheme:
        scheme: https
        permanent: true

    dashboard-auth:
      basicAuth:
        users:
          - "${TRAEFIK_BASIC_AUTH}"
